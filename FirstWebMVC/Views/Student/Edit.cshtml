@model FirstWebMVC.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit" method="post">

<input type="hidden" name="Id" value="@Model.Id" />

<div class="form-group">
<label>Mã SV</label>
<input type="text" class="form-control" name="StudentCode" value="@Model.StudentCode" readonly />
</div>

<div class="form-group">
<label>Họ tên SV</label>
<input type="text" class="form-control" name="FullName" value="@Model.FullName" />
</div>

<div class="form-group">
<label>Tuổi</label>
<input type="number" class="form-control" name="Age" value="@Model.Age" />
</div>
<br/>
<div class="form-group">
<label>Email</label>
<input type="text" class="form-control" name="Email" value="@Model.Email" />
</div>
<div class="form-group">
<label asp-for="FacultyId" class="control-label"></label>
<select asp-for="FacultyId" class="form-control" asp-items="ViewBag.FacultyId"></select>
<span asp-validation-for="FacultyId" class="text-danger"></span>
</div>
<br/>
<button type="submit" class="btn btn-primary">Submit</button>
</form>